GROQ_API_KEY=your_groq_api_key_here

# Optionnel — uniquement requis pour l'ingestion de PDF scannés (OCR).
# Sans ces variables, src/ingestion/ocr.py retombe sur des chemins par
# défaut propres à la machine de développement d'origine, qui ne
# fonctionneront probablement pas ailleurs.
TESSERACT_PATH=C:\Path\To\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\Path\To\poppler\Library\bin
